# Backend API URL
# Server-side only. Browser API requests go through /api/backend so auth
# cookies remain first-party. Do not expose this as NEXT_PUBLIC_* in production.
API_URL=http://localhost:3001

# WalletConnect (Reown Cloud) — get from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Set to 31337 to target a local Hardhat node instead of Base Sepolia.
NEXT_PUBLIC_CHAIN_ID=
